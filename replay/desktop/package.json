{
  "name": "panda-data-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "Panda 数据采集与回放桌面工作台",
  "author": "Panda Data Workbench",
  "type": "module",
  "main": "main.mjs",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "start": "electron .",
    "package:dir": "electron-builder --linux dir --publish never",
    "package": "electron-builder --linux AppImage --publish never",
    "package:cpu": "electron-builder --linux AppImage --publish never",
    "test": "node --test tests/*.test.mjs",
    "test:packaged": "node scripts/smoke-packaged.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "agent-browser": "^0.38.2",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.panda.data-workbench",
    "productName": "Panda Data Workbench",
    "asar": true,
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "../../dist/electron-cpu"
    },
    "files": [
      "main.mjs",
      "lifecycle.mjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../../build/desktop/cpu/runtime",
        "to": "runtime"
      },
      {
        "from": "../../replay/frontend/dist",
        "to": "frontend"
      },
      {
        "from": "../../build/desktop/cpu/config",
        "to": "config"
      }
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "executableName": "panda-data-workbench",
      "category": "Science",
      "artifactName": "panda-data-workbench-${version}-cpu-${arch}.${ext}"
    }
  }
}
